  "welcomeStep1Title": {
    "message": "Tuzakları ben engellerim",
    "description": "Welcome step 1 title."
  },
  "welcomeStep1Body": {
    "message": "IP logger ve link grabber alan adları, istek ağa ulaşmadan durdurulur. Bugün 125 bilinen servis; herkese açık kaynaklardan güncellenir.",
    "description": "Welcome step 1 body."
  },
  "welcomeStep2Title": {
    "message": "Bir sayfa, hayalet değil",
    "description": "Welcome step 2 title."
  },
  "welcomeStep2Body": {
    "message": "Bu sekmede bir bağlantı engellendiğinde engel sayfası hedef adresi, kanıtı ve seçeneklerini gösterir: bu sekme için izin, siteye izin ya da geri dön.",
    "description": "Welcome step 2 body."
  },
  "welcomeStep3Title": {
    "message": "Sadece gerekinde konuşurum",
    "description": "Welcome step 3 title."
  },
  "welcomeStep3Body": {
    "message": "Uyarı bandı yalnızca tehlike seviyesinde bir bulgu veya aynı anda iki uyarı kategorisi için görünür. Tek zayıf sinyal, popup'ta sessiz bir rozet olarak kalır.",
    "description": "Welcome step 3 body."
  },
  "welcomeStep4Title": {
    "message": "Kontroller senin",
    "description": "Welcome step 4 title."
  },
  "welcomeStep4Body": {
    "message": "Araç çubuğu ikonuna istediğinde tıklayın: sekmenin canlı durumu, yakalanan sinyaller, sayaclar. Oradan engelleyin ya da izin verin. İzin listesi her zaman engel listesini yener.",
    "description": "Welcome step 4 body."
  },
  "welcomeStep5Title": {
    "message": "Panel",
    "description": "Welcome step 5 title."
  },
  "welcomeStep5Body": {
    "message": "Aranabilir listeler, filtrelenebilir olay kaydı, kaynak sağlığı, ayarlar ve yedekleme. Her şey klavyeyle erişilebilir; okuduğun tur da burada yaşar.",
    "description": "Welcome step 5 body."
  },
  "welcomeStep6Title": {
    "message": "Yerel. Her zaman.",
    "description": "Welcome step 6 title."
  },
  "welcomeStep6Body": {
    "message": "Telemetri yok, analitik yok, hesap yok. Ayarlar, sayaclar ve 500 kayıtlık olay kaydı yalnızca bu tarayıcıda kalır. WebRTC politikası isteğe bağlıdır ve tarayıcı genelindedir.",
    "description": "Welcome step 6 body."
  },
